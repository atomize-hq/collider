{
  "projectVersion": "1",
  "tokens": {
    "format": "family-files-v1",
    "sourceDir": "design-tokens/src/tokens",
    "recipesDir": "design-tokens/src/recipes",
    "extensionsNamespace": "com.atomizehq.collider",
    "themes": {
      "registry": "design-tokens/src/tokens/themes/registry.json",
      "directory": "design-tokens/src/tokens/themes"
    },
    "figma": {
      "excludedFamilies": ["tailwind-colors", "tailwind-variables", "font"]
    },
    "build": {
      "compiler": "tokens-studio-css-v1",
      "banner": "This file is generated by pnpm build:tokens. Do not edit by hand.",
      "formatting": {
        "semi": true,
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "printWidth": 100
      },
      "runtime": {
        "themeAttribute": "data-theme",
        "identicalThemes": "error",
        "compatibility": {
          "inventory": "design-tokens/src/tokens/migrations/runtime-variable-inventory.json",
          "aliases": "design-tokens/src/tokens/migrations/runtime-css-aliases.json",
          "categoryLabels": {
            "background": "Background",
            "text": "Text",
            "status-strip": "StatusStrip"
          }
        }
      },
      "outputs": {
        "stagedCss": "design-tokens/dist/css/tokens.css",
        "runtimeCss": "src/lib/tokens/tokens.css",
        "typescript": "design-tokens/dist/tokens.ts",
        "figma": "design-tokens/dist/figma/tokens.json"
      },
      "lockPath": ".codex-artifacts/locks/build-tokens.lock"
    },
    "runtimeChecks": {
      "compatibilitySurface": "scripts/token-runtime-compatibility-surface.json",
      "imports": {
        "format": "css-import-v1",
        "entries": [
          {
            "file": "src/app/globals.css",
            "specifier": "../lib/tokens/tokens.css"
          }
        ]
      }
    },
    "manualEditGuard": {
      "policy": "git-input-dirty-v1",
      "generatorInputs": ["ds-skills.release.json"]
    },
    "governance": {
      "publication": {
        "config": "figma/token-sync.config.json",
        "baseline": "figma/token-rail.baseline.json",
        "ledger": "src/figma/sync-ledger.json",
        "profile": "src/figma/validation-profile.json",
        "proof": "src/figma/publish-proof.json"
      }
    }
  },
  "storybook": {
    "format": "csf-policy-v1",
    "inventory": "storybook/story-inventory.json",
    "tierPolicy": "storybook/component-tier-policy.json",
    "versionPolicy": ".storybook/storybook-version-policy.json",
    "proof": {
      "adapter": "csf-ts-v1",
      "storyRoots": ["src", "storybook/stories"],
      "componentSpecs": "storybook/component-specs",
      "generatedArtifactKeys": ["tokenDocs", "recipeDocs", "runtimeParity"],
      "coverage": "artifacts/storybook/proof-coverage.json",
      "lockPath": ".codex-artifacts/locks/storybook-proof.lock",
      "formatting": {
        "printWidth": 100,
        "tabWidth": 2,
        "useTabs": false
      }
    },
    "chromatic": {
      "status": "artifacts/chromatic/status.json",
      "lockPath": ".codex-artifacts/locks/review-restore.lock",
      "checkName": "chromatic-review",
      "requiredForClaim": true,
      "maxAgeMinutes": 1440,
      "maxFutureSkewSeconds": 60,
      "restore": {
        "apiBase": "https://api.github.com",
        "repository": "atomize-hq/collider",
        "workflow": "ci.yml",
        "artifactPrefix": "chromatic-status-",
        "entry": "status.json",
        "tokenEnv": "GH_TOKEN",
        "maxPages": 10
      },
      "publish": {
        "provider": "chromatic-node-v15",
        "buildDir": "storybook-static",
        "tokenEnv": "CHROMATIC_PROJECT_TOKEN",
        "repository": "atomize-hq/collider",
        "timeoutSeconds": 1200,
        "mode": "review"
      }
    }
  },
  "components": {
    "report": "artifacts/harness/reusable-component-status.json",
    "lockPath": ".codex-artifacts/locks/component-evidence.lock",
    "maxAgeMinutes": 60,
    "profiles": {
      "reference": {
        "requirements": ["story-coverage"],
        "consumers": {
          "docs": "blocking"
        }
      },
      "component-review": {
        "requirements": ["story-coverage", "visual-review"],
        "consumers": {
          "ci": "blocking",
          "local": "advisory",
          "handoff": "blocking"
        }
      },
      "publication-record": {
        "requirements": ["figma-publication"],
        "consumers": {
          "release": "blocking"
        }
      },
      "release": {
        "requirements": ["story-coverage", "visual-review", "figma-publication"],
        "consumers": {
          "release": "blocking"
        }
      }
    }
  }
}
