{
  "projectVersion": "1",
  "tokens": {
    "format": "family-files-v1",
    "sourceDir": "design-tokens/src/tokens",
    "recipesDir": "design-tokens/src/recipes",
    "extensionsNamespace": "com.atomizehq.collider",
    "themes": {
      "registry": "design-tokens/src/tokens/themes/registry.json",
      "directory": "design-tokens/src/tokens/themes"
    },
    "figma": {
      "excludedFamilies": ["tailwind-colors", "tailwind-variables", "font"]
    },
    "build": {
      "compiler": "tokens-studio-css-v1",
      "banner": "This file is generated by pnpm build:tokens. Do not edit by hand.",
      "formatting": {
        "semi": true,
        "singleQuote": true,
        "tabWidth": 2,
        "trailingComma": "es5",
        "printWidth": 100
      },
      "runtime": {
        "themeAttribute": "data-theme",
        "identicalThemes": "error",
        "compatibility": {
          "inventory": "design-tokens/src/tokens/migrations/runtime-variable-inventory.json",
          "aliases": "design-tokens/src/tokens/migrations/runtime-css-aliases.json",
          "categoryLabels": {
            "background": "Background",
            "text": "Text",
            "status-strip": "StatusStrip"
          }
        }
      },
      "outputs": {
        "stagedCss": "design-tokens/dist/css/tokens.css",
        "runtimeCss": "src/lib/tokens/tokens.css",
        "typescript": "design-tokens/dist/tokens.ts",
        "figma": "design-tokens/dist/figma/tokens.json"
      },
      "lockPath": ".codex-artifacts/locks/build-tokens.lock"
    },
    "runtimeChecks": {
      "compatibilitySurface": "scripts/token-runtime-compatibility-surface.json",
      "imports": {
        "format": "css-import-v1",
        "entries": [
          {
            "file": "src/app/globals.css",
            "specifier": "../lib/tokens/tokens.css"
          }
        ]
      }
    },
    "manualEditGuard": {
      "policy": "git-input-dirty-v1",
      "generatorInputs": ["ds-skills.release.json"]
    }
  }
}
