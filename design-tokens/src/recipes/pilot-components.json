{
  "registryVersion": "1",
  "metadataEnums": {
    "pilotStatus": ["active", "deferred"],
    "handoffStatus": ["source-ready", "ready-for-build", "ready-for-docs"]
  },
  "components": [
    {
      "componentId": "badge",
      "pilotStatus": "active",
      "handoffStatus": "ready-for-docs",
      "variantAxes": [
        {
          "name": "variant",
          "values": [
            "default",
            "secondary",
            "destructive",
            "outline",
            "success",
            "warning",
            "error"
          ]
        }
      ],
      "defaults": {
        "variants": {
          "variant": "default"
        },
        "state": "rest"
      },
      "slots": ["root", "label", "icon"],
      "states": ["rest", "hover", "focus"],
      "fallbacks": {
        "missingVariantBehavior": "use-defaults",
        "stateFallbacks": {
          "hover": "rest",
          "focus": "rest"
        }
      }
    },
    {
      "componentId": "input",
      "pilotStatus": "deferred",
      "handoffStatus": "source-ready"
    },
    {
      "componentId": "card",
      "pilotStatus": "deferred",
      "handoffStatus": "source-ready"
    }
  ]
}
