/storybook-static/

# agent tooling
#
# ds-skills discovery assets and their receipt are tracked generated copies.
# Installation verifies their release digests; no home-directory links are used.
.claude/settings.local.json
.codex-artifacts/

# harness outputs
#
# The promotion gate writes this on every run and never reads it back, and CI
# regenerates it from a freshly downloaded Chromatic status before uploading it
# as a build artifact. Nothing consumes the committed copy, so tracking it only
# produced a snapshot that drifted — the checked-in version sat five months
# stale, still claiming a Chromatic review that expires after 24 hours was
# current. Regenerate with `pnpm generate:reusable-component-status`.
/artifacts/harness/reusable-component-status.json

# figma plugins
/figma/plugins/**/dist/
/figma/plugins/**/code.js
/figma/plugins/**/code.js.map

# Codex CLI session ids, written by `/codex` so a follow-up consult can resume
# the prior conversation. Machine-local and per-developer — a shared id would
# resume someone else's thread.
/.context/

# Figma plugin build output. Source lives in @atomize-hq/ds-skills and is
# stamped with figma/token-sync.config.json; rebuild with `pnpm figma:plugin:build`.
figma/plugins/collider-token-sync/code.js
figma/plugins/collider-token-sync/code.js.map
figma/plugins/collider-token-sync/ui.html
figma/plugins/collider-token-sync/manifest.json


# Revision-bound review output; never restore a committed stale review as evidence.
/artifacts/chromatic/status.json
