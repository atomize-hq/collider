{
  "recipeVersion": "1",
  "componentId": "button",
  "variantAxes": [
    { "name": "intent", "values": ["primary", "secondary"] },
    { "name": "size", "values": ["sm", "md"] }
  ],
  "defaults": {
    "variants": { "intent": "primary", "size": "md" },
    "state": "rest"
  },
  "slots": {
    "root": { "background": "#202020" },
    "label": { "text": "{semantic.color.text.primary}" },
    "icon": { "color": "{semantic.color.text.primary}" }
  },
  "states": {
    "rest": {
      "root": { "background": "{semantic.color.background.surface}" }
    },
    "hover": {
      "root": { "background": "{semantic.color.background.elevated}" }
    },
    "focus": {
      "root": { "background": "{semantic.color.background.overlay}" }
    },
    "disabled": {
      "label": { "text": "{semantic.color.text.secondary}" }
    }
  },
  "fallbacks": {
    "missingVariantBehavior": "use-defaults",
    "stateFallbacks": {
      "hover": "rest",
      "focus": "rest",
      "disabled": "rest"
    }
  }
}
