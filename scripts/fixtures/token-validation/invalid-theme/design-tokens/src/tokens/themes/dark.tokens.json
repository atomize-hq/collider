{
  "$extensions": {
    "com.atomizehq.collider": {
      "themeId": "dark"
    }
  },
  "semantic": {
    "color": {
      "background": {
        "surface": { "$value": "{core.color.neutral.900}", "$type": "color" },
        "elevated": { "$value": "{core.color.neutral.850}", "$type": "color" },
        "overlay": { "$value": "{core.color.neutral.800}", "$type": "color" }
      },
      "text": {
        "primary": { "$value": "{core.color.white}", "$type": "color" },
        "secondary": { "$value": "{core.color.neutral.500}", "$type": "color" }
      }
    }
  }
}
