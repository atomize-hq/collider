{
  "name": "collider",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:tauri": "TAURI=true next build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "chromatic:review": "node .ds-skills/project.mjs chromatic review publish --config ds-skills.project.json",
    "validate:chromatic-status": "node .ds-skills/project.mjs chromatic status validate --config ds-skills.project.json",
    "restore:chromatic-status": "node .ds-skills/project.mjs chromatic status restore --config ds-skills.project.json",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "validate:storybook-policy": "node .ds-skills/project.mjs storybook policy validate --config ds-skills.project.json",
    "validate:storybook-tier-policy": "node .ds-skills/project.mjs storybook policy validate --config ds-skills.project.json",
    "validate:storybook-story-inventory": "node .ds-skills/project.mjs storybook policy validate --config ds-skills.project.json",
    "validate:storybook-proof-structure": "node .ds-skills/project.mjs storybook proof validate --config ds-skills.project.json",
    "validate:upstream-policy": "node .ds-skills/project.mjs sources policy check --config ds-skills.project.json",
    "validate:consumer-contract": "node .ds-skills/project.mjs sources contract check --config ds-skills.project.json",
    "baseline:upstream": "node .ds-skills/project.mjs registries capture --config ds-skills.project.json",
    "baseline:rail": "node .ds-skills/project.mjs figma baseline --config figma/token-sync.config.json --artifact design-tokens/dist/figma/tokens.json --out figma",
    "generate:storybook-proof-coverage": "node .ds-skills/project.mjs storybook proof build --config ds-skills.project.json",
    "generate:reusable-component-status": "node .ds-skills/project.mjs components status build --config ds-skills.project.json",
    "govern:reusable-component-promotion": "node .ds-skills/project.mjs components promote --config ds-skills.project.json",
    "validate:reusable-component-status": "node .ds-skills/project.mjs components status check --config ds-skills.project.json",
    "govern:storybook-proof": "node .ds-skills/project.mjs storybook proof build --config ds-skills.project.json",
    "validate:tokens": "node .ds-skills/project.mjs tokens validate --config ds-skills.project.json",
    "build:tokens": "node .ds-skills/project.mjs tokens build --config ds-skills.project.json",
    "validate:sync-ledger": "node .ds-skills/project.mjs ledger validate --ledger src/figma/sync-ledger.json --profile src/figma/validation-profile.json",
    "validate:publish-proof": "node .ds-skills/project.mjs proof validate --proof src/figma/publish-proof.json --profile src/figma/validation-profile.json",
    "ds-skills:install": "node .ds-skills/project.mjs --install",
    "ds-skills:check": "node .ds-skills/project.mjs --check",
    "figma:plugin:build": "node .ds-skills/project.mjs figma plugin build --config figma/token-sync.config.json --out figma/plugins/collider-token-sync",
    "figma:verify": "node .ds-skills/project.mjs figma verify --config figma/token-sync.config.json --expect figma/token-rail.baseline.json --artifact design-tokens/dist/figma/tokens.json",
    "figma:foundations:build": "node scripts/build-foundations-page.mjs",
    "figma:tokens:serve": "node .ds-skills/project.mjs figma serve --config figma/token-sync.config.json --artifact design-tokens/dist/figma/tokens.json",
    "validate:figma-parity": "node .ds-skills/project.mjs ledger parity --ledger src/figma/sync-ledger.json --profile src/figma/validation-profile.json",
    "govern:tokens": "node .ds-skills/project.mjs tokens govern --config ds-skills.project.json",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project unit --coverage --passWithNoTests",
    "test:storybook": "vitest run --project storybook --project storybook-light --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "knip",
    "cargo:fmt": "cd src-tauri && cargo fmt --all",
    "cargo:fmt:check": "cd src-tauri && cargo fmt --all -- --check",
    "cargo:clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "cargo:test": "cd src-tauri && cargo nextest run --no-tests=pass",
    "cargo:deny": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "cargo:machete": "cd src-tauri && cargo machete",
    "baseline:upstream:check": "node .ds-skills/project.mjs registries check --config ds-skills.project.json",
    "baseline:upstream:diff": "node .ds-skills/project.mjs registries diff --config ds-skills.project.json"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.66",
    "ansi-to-react": "^6.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.0.1",
    "motion": "^12.38.0",
    "nanoid": "^6.0.1",
    "next": "^16.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-jsx-parser": "^2.4.1",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tokenlens": "^1.3.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.2.19",
    "@storybook/addon-designs": "^11.1.2",
    "@storybook/addon-vitest": "10.2.19",
    "@storybook/nextjs-vite": "10.2.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "4.1.0",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "4.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.7",
    "husky": "9.1.7",
    "knip": "5.87.0",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "storybook": "10.2.19",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
