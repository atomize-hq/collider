    "@vitest/browser": "4.1.0",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "4.1.0",
    "chromatic": "^15.3.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.7",
    "husky": "9.1.7",
    "knip": "5.87.0",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "storybook": "10.2.19",
    "style-dictionary": "^5.3.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
