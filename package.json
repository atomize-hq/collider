{
  "name": "collider",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:tauri": "TAURI=true next build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "chromatic:review": "node scripts/chromatic-review.mjs",
    "validate:chromatic-status": "node scripts/validate-chromatic-status.mjs",
    "restore:chromatic-status": "node scripts/restore-chromatic-status.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "validate:storybook-policy": "node scripts/validate-storybook-version-policy.mjs .storybook/storybook-version-policy.json",
    "validate:storybook-tier-policy": "node scripts/validate-storybook-tier-policy.mjs",
    "validate:storybook-story-inventory": "node scripts/validate-storybook-story-inventory.mjs",
    "validate:storybook-proof-structure": "node scripts/validate-storybook-proof-structure.mjs",
    "generate:storybook-proof-coverage": "node scripts/generate-storybook-proof-coverage.mjs",
    "generate:component-mapping": "node scripts/generate-component-mapping.mjs",
    "generate:reusable-component-status": "node scripts/generate-reusable-component-status.mjs",
    "govern:reusable-component-promotion": "node scripts/govern-reusable-component-promotion.mjs",
    "validate:reusable-component-mapping": "node scripts/validate-reusable-component-mapping.mjs",
    "validate:reusable-component-status": "node scripts/validate-reusable-component-status.mjs",
    "govern:storybook-proof": "node scripts/govern-storybook-proof.mjs",
    "validate:tokens": "node design-tokens/build/validate-tokens.mjs",
    "build:tokens": "node design-tokens/build/build-tokens.mjs",
    "validate:sync-ledger": "node scripts/validate-sync-ledger.mjs src/figma/sync-ledger.json",
    "validate:publish-proof": "node scripts/validate-publish-proof.mjs",
    "figma:plugin:build": "node scripts/build-figma-plugin.mjs",
    "figma:tokens:serve": "node scripts/serve-figma-tokens.mjs",
    "figma:sync:variables:enterprise": "node scripts/figma-variables-sync-enterprise.mjs",
    "figma:connect:validate": "figma connect publish --dry-run --skip-update-check",
    "figma:connect:publish": "figma connect publish --skip-update-check",
    "validate:figma-parity": "node scripts/validate-figma-parity.mjs",
    "govern:tokens": "node scripts/govern-tokens.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project unit --coverage --passWithNoTests",
    "test:storybook": "vitest run --project storybook --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "knip",
    "cargo:fmt": "cd src-tauri && cargo fmt --all",
    "cargo:fmt:check": "cd src-tauri && cargo fmt --all -- --check",
    "cargo:clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "cargo:test": "cd src-tauri && cargo nextest run --no-tests=pass",
    "cargo:deny": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "cargo:machete": "cd src-tauri && cargo machete"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
