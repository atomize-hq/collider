{
  "name": "collider",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:tauri": "TAURI=true next build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "validate:storybook-policy": "node scripts/validate-storybook-version-policy.mjs .storybook/storybook-version-policy.json",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:watch": "vitest --project unit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --project unit --coverage --passWithNoTests",
    "test:storybook": "vitest run --project storybook --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "knip",
    "cargo:fmt": "cd src-tauri && cargo fmt --all",
    "cargo:fmt:check": "cd src-tauri && cargo fmt --all -- --check",
    "cargo:clippy": "cd src-tauri && cargo clippy -- -D warnings",
    "cargo:test": "cd src-tauri && cargo nextest run",
    "cargo:deny": "cargo deny --manifest-path src-tauri/Cargo.toml check",
    "cargo:machete": "cd src-tauri && cargo machete"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.1",
  "dependencies": {
    "next": "^16.1.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "1.58.2",
    "@storybook/addon-a11y": "10.2.19",
    "@storybook/addon-designs": "^11.1.2",
    "@storybook/addon-vitest": "10.2.19",
    "@storybook/nextjs-vite": "10.2.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "@vitest/ui": "4.1.0",
    "eslint": "^10.0.3",
    "eslint-config-next": "^16.1.7",
    "husky": "9.1.7",
    "knip": "5.87.0",
    "lint-staged": "16.4.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "storybook": "10.2.19",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
